# Compute Engine VM 上で backend/db.sqlite3 の代わりに使う PostgreSQL コンテナ
# 用の設定。VM 上でこのファイルを `.env.gcp` としてコピーし、実際の値を入れる。
# `.env.gcp` はコミットしないこと (.gitignore 済み)。docker-compose.yml が
# db / app 両サービスへそのまま読み込む。

# --- PostgreSQL (db コンテナ) ---
POSTGRES_DB=paymethodfinder
POSTGRES_USER=paymethodfinder
POSTGRES_PASSWORD=choose-a-strong-password

# --- Django (app コンテナ) ---
# ホスト名は docker-compose のサービス名 "db" 固定。ユーザー/パスワード/DB名は
# 上の POSTGRES_* と一致させること。
DATABASE_URL=postgres://paymethodfinder:choose-a-strong-password@db:5432/paymethodfinder

DJANGO_DEBUG=false
# 生成例: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-generated-secret-key
# VM の外部IPまたは独自ドメイン
DJANGO_ALLOWED_HOSTS=your-vm-external-ip-or-domain
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# アプリ全体を保護する共有パスワード
APP_PASSWORD=choose-a-shared-app-password

# 任意: 初回起動時に管理者アカウントを作成する場合のみ設定
# (DBデータは postgres_data ボリュームに永続化されるため、
# 既にアカウントが存在する場合は何もしない)
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# 任意: レシート読み取り(OCR)機能を使う場合のみ、GCPサービスアカウントキー
# JSONの中身をそのまま貼り付ける
GOOGLE_APPLICATION_CREDENTIALS_JSON=
