# Copy to backend/.env and export these before running the server.
# Without DJANGO_DEBUG=true, DJANGO_SECRET_KEY and APP_PASSWORD are required
# and the server refuses to start without them.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-this-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The shared password visitors type to open the app. Pick your own; never
# commit a real one. Required unless DJANGO_DEBUG=true.
APP_PASSWORD=choose-a-local-password
